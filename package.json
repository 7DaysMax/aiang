{
  "name": "aiang",
  "type": "module",
  "version": "0.63.0",
  "description": "Youmi Aiagent — a DeepSeek-native coding agent UI",
  "author": "Youmi",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "chat",
    "ui",
    "agent",
    "anthropic",
    "bun",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/example/aiang.git"
  },
  "bin": {
    "aiang": "./bin/aiang"
  },
  "main": "electron/main.cjs",
  "packageManager": "bun@1.3.5",
  "files": [
    "bin/",
    "src/server/",
    "src/shared/",
    "vendor/",
    "dist/client/",
    "dist/export-viewer/"
  ],
  "engines": {
    "bun": ">=1.3.5"
  },
  "scripts": {
    "build": "bun run build:client && bun run build:export-viewer",
    "build:client": "vite build",
    "build:export-viewer": "vite build --config vite.export-viewer.config.ts",
    "prepare:export-viewer-release-assets": "bun run ./scripts/prepare-export-viewer-release-assets.ts",
    "check": "tsc --noEmit && bun run build:client && bun run build:export-viewer",
    "dev": "bun run ./scripts/dev.ts",
    "dev:cloud": "KANNA_DEVBOX_UI=1 bun run ./scripts/dev.ts",
    "dev:client": "vite --host 0.0.0.0 --port 5174",
    "dev:server": "bun run ./scripts/dev-server.ts --no-open --port 5175",
    "dev:desktop": "electron .",
    "install:dev": "bun install && bun run build && bun install -g .",
    "start": "bun run ./src/server/cli.ts",
    "test": "bun test",
    "test:cloud": "bun test ./src/server/cloud/wire.e2e.ts",
    "youmi:bench": "bun run ./scripts/youmi-bench/run.ts",
    "youmi:evolve": "bun run ./scripts/youmi-evolve.ts",
    "pack:exe": "bun run ./scripts/pack-exe.ts",
    "prepublishOnly": "bun run build"
  },
  "build": {
    "appId": "com.youmi.aiagent",
    "productName": "Youmi Aiagent",
    "copyright": "Copyright © Youmi",
    "directories": {
      "output": "release/electron"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "assets/icon-256.png",
      "assets/icon.ico"
    ],
    "extraResources": [
      {
        "from": "release/staging/aiang-server.exe",
        "to": "aiang-server.exe"
      },
      {
        "from": "release/staging/package.json",
        "to": "package.json"
      },
      {
        "from": "release/staging/dist",
        "to": "dist"
      },
      {
        "from": "release/staging/vendor",
        "to": "vendor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "YoumiAiagent"
    },
    "portable": {
      "artifactName": "Youmi-Aiagent-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "Youmi-Aiagent-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Youmi Aiagent",
      "uninstallDisplayName": "Youmi Aiagent",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "asar": true
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.104.0",
    "@central-icons-react/round-outlined-radius-2-stroke-2": "^1.1.315",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@mariozechner/pi-ai": "0.73.1",
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@opentelemetry/api": "^1.9.1",
    "@prismshadow/agenthub": "0.4.1",
    "@prismshadow/penguin-core": "0.2.2",
    "@prismshadow/penguin-skills": "0.2.2",
    "@shadcn/react": "^0.2.1",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "cloudflared": "^0.7.1",
    "default-shell": "^2.2.0",
    "diff": "^8.0.3",
    "file-type": "^22.0.0",
    "glimm": "^0.3.0",
    "iconoir-react": "^7.12.1",
    "liveline": "^0.0.7",
    "material-file-icons": "^2.4.0",
    "openai": "^6.34.0",
    "shadow-plugin": "^2.1.0",
    "shiki": "^3.23.0",
    "simple-icons": "^16.28.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@pierre/diffs": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "latest",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "command-score": "^0.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.562.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.7.3",
    "react-router-dom": "^7.12.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "5.8.3",
    "vite": "^6.0.0",
    "zustand": "^5.0.10"
  }
}
